# Copy to .env locally. Never commit a populated .env file.
# Use an OKX Demo Trading API key only. Never grant Withdraw permission.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Region where your OKX account was registered (not your current IP location).
# Allowed: global, us_au, eea. This selects only a fixed Demo host; never paste a URL.
NEBULA_OKX_REGION=global

# Only set true for a dedicated Demo account with no manual/other-bot trading
# and a clean local P&L baseline. Required for risk authorization; default is false.
NEBULA_DEMO_ACCOUNT_EXCLUSIVE=false

# Safety defaults: order submission remains disabled.
NEBULA_ENABLE_DEMO_ORDERS=false
NEBULA_KILL_SWITCH=true

# Risk limits must be explicitly configured before Demo order permission can pass.
NEBULA_MAX_DAILY_LOSS_QUOTE=0
NEBULA_MAX_RISK_QUOTE=0
NEBULA_MAX_POSITION_QUOTE=0

# Conservative placeholders; calibrate before any Demo forward test.
NEBULA_FEE_BPS=10
NEBULA_SLIPPAGE_BPS=10
NEBULA_MARKET_DATA_MAX_AGE_MS=30000

# Set false to disable automatic copying of successful CLI result output.
NEBULA_AUTO_COPY_RESULT=true
